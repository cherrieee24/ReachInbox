# ---- Server ----
NODE_ENV=development
PORT=4000
# Where the SPA runs. Used for CORS and for the post-login redirect.
FRONTEND_URL=http://localhost:5173
# Comma-separated list of origins allowed to send credentialed requests.
CORS_ORIGIN=http://localhost:5173

# ---- PostgreSQL (Prisma) ----
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox
POSTGRES_DB=reachinbox
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public

# ---- Session ----
# Generate with: openssl rand -base64 48
JWT_SECRET=
SESSION_TTL_SECONDS=604800
# Only set in production when the API and SPA share a parent domain.
COOKIE_DOMAIN=
# lax | strict | none. Keep lax unless the SPA and the API are on unrelated
# domains (a CDN plus a separate PaaS), where a Lax cookie is never sent on
# cross-site XHR and every API call would 401. `none` requires HTTPS.
COOKIE_SAMESITE=lax

# ---- Google OAuth ----
# From https://console.cloud.google.com/apis/credentials (Web application client).
# The callback URL below must be listed verbatim under "Authorised redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- Redis (BullMQ) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Elasticsearch ----
ELASTICSEARCH_NODE=http://localhost:9200

# ---- Ethereal Email (the only transport) ----
# Ethereal captures mail and never delivers it. Leave USER/PASSWORD blank to
# have a throwaway account provisioned at startup; fill them in from
# https://ethereal.email/create to keep one account across restarts.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_SECURE=false
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# ---- Slack OAuth ----
# From https://api.slack.com/apps -> your app -> Basic Information / OAuth.
# The redirect URI below must be listed verbatim under "Redirect URLs".
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
SLACK_SCOPES=incoming-webhook,chat:write

# ---- Secrets at rest ----
# Encrypts Slack tokens and sender passwords. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# ---- Queue worker (BullMQ) ----
# Run the worker inside the API process. Set false to run `npm run worker` separately.
WORKER_ENABLED=true
# How many sends one worker processes at once.
WORKER_CONCURRENCY=5
# Floor on every job's delay, so nothing is enqueued to run instantly.
EMAIL_MIN_DELAY_MS=1000
# Retry policy for a failed send.
EMAIL_JOB_ATTEMPTS=3
EMAIL_JOB_BACKOFF_MS=30000

# ---- Serving the SPA from this process ----
# Optional. When true the API also serves frontend/dist, putting the app and
# the API on one origin — no CORS allowlist, no cross-site cookie problem.
SERVE_FRONTEND=false
FRONTEND_DIST_PATH=../frontend/dist

# ---- Logging ----
# debug | info | warn | error
LOG_LEVEL=debug

# ---- Throttling ----
# Minimum gap between two sends from the same sender. Enforced in Redis, so it
# holds across every worker and backend instance.
MIN_EMAIL_DELAY_MS=1000
# Ceiling on sends per sender per hour window. A campaign's own hourlyLimit may
# be lower; the smaller of the two always wins.
MAX_EMAILS_PER_HOUR=100

# ---- Elasticsearch (search index only — never the source of truth) ----
ELASTICSEARCH_INDEX=reachinbox-emails
# Skip search calls for this long after a failure, so a down cluster is not hammered.
ELASTICSEARCH_COOLDOWN_MS=15000
ELASTICSEARCH_TIMEOUT_MS=3000

# ---- Admin ----
# Comma-separated emails promoted to ADMIN on sign-in, unlocking /admin/queues.
# Promotion only; removing an address here does not demote an existing admin.
ADMIN_EMAILS=

# ---- HTTP rate limiting ----
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_HEAVY_PER_MINUTE=30
