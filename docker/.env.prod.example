# Production stack credentials — used by docker-compose.prod.yml AND passed
# into the api/worker containers as their application environment.
# Copy to docker/.env.prod and fill in. Never commit the filled-in file.

# ---- Datastores ----
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=reachinbox
REDIS_PASSWORD=CHANGE_ME
ELASTIC_PASSWORD=CHANGE_ME
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ---- Application ----
NODE_ENV=production
PORT=4000

# Service names below are the compose service names, not localhost.
# Substitute the same passwords you set above.
DATABASE_URL=postgresql://reachinbox:CHANGE_ME@postgres:5432/reachinbox?schema=public
REDIS_URL=redis://:CHANGE_ME@redis:6379
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME

# Public origin of the deployment. No localhost defaults apply in production —
# the server refuses to boot without these.
FRONTEND_URL=https://your-domain.example
CORS_ORIGIN=https://your-domain.example

# Port the nginx/web container is published on.
WEB_PORT=8080

# ---- Session ----
# openssl rand -base64 48
JWT_SECRET=
SESSION_TTL_SECONDS=604800
# Set when the SPA and API sit on different subdomains of one parent domain.
COOKIE_DOMAIN=
# lax (default) when they share a registrable domain — including the
# same-origin nginx setup this compose file uses.
# none ONLY when they are on unrelated domains; requires HTTPS.
COOKIE_SAMESITE=lax

# ---- Google OAuth ----
# The callback below must be registered verbatim in the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.example/api/auth/google/callback

# ---- Slack OAuth ----
# The redirect below must be registered verbatim in the Slack app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-domain.example/api/slack/callback
SLACK_SCOPES=incoming-webhook,chat:write

# ---- Secrets at rest ----
# openssl rand -base64 32
ENCRYPTION_KEY=

# ---- Ethereal (the only transport — captures mail, never delivers) ----
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_SECURE=false
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# ---- Worker / throttling ----
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=1000
MAX_EMAILS_PER_HOUR=100
EMAIL_JOB_ATTEMPTS=3
EMAIL_JOB_BACKOFF_MS=30000

# ---- Admin ----
ADMIN_EMAILS=

# ---- Logging ----
LOG_LEVEL=info
