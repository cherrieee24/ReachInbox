# Base URL the frontend calls for the API.
# Leave unset (or "/api") in development so the Vite dev proxy forwards to the backend.
# In other environments set the full origin, e.g. https://api.reachinbox.ai
VITE_API_URL=/api

# Where the dev-server proxy forwards /api requests. Only used in development.
VITE_API_PROXY_TARGET=http://localhost:4000

# Port the Vite dev server binds to.
VITE_DEV_PORT=5173
